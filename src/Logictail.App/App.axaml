<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Logictail.App.App"
             RequestedThemeVariant="Light">
  <!-- Tokens: see docs/DESIGN.md. Colors follow LogicERP's portal CSS. -->
  <Application.Resources>
    <!-- Fluent sizes tab headers from this resource, not from FontSize. -->
    <x:Double x:Key="TabItemHeaderFontSize">12</x:Double>
    <FontFamily x:Key="UiFont">avares://Logictail/Assets/Fonts#Montserrat</FontFamily>
    <Color x:Key="TealColor">#67929E</Color>
    <SolidColorBrush x:Key="Teal" Color="#67929E" />
    <SolidColorBrush x:Key="TealDark" Color="#557D88" />
    <SolidColorBrush x:Key="TealLight" Color="#9BB5BC" />
    <SolidColorBrush x:Key="TealMist" Color="#E8EEF0" />
    <SolidColorBrush x:Key="Paper" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Canvas" Color="#F3F5F6" />
    <SolidColorBrush x:Key="Charcoal" Color="#323537" />
    <SolidColorBrush x:Key="Slate" Color="#6C7A7F" />
    <SolidColorBrush x:Key="Rule" Color="#DEE2E6" />
    <SolidColorBrush x:Key="Hover" Color="#F1F3F5" />
  </Application.Resources>

  <Application.Styles>
    <FluentTheme>
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Light" Accent="#67929E" BaseHigh="#323537" RegionColor="#FFFFFF" />
      </FluentTheme.Palettes>
    </FluentTheme>

    <Style Selector="Window">
      <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="{StaticResource Charcoal}" />
      <Setter Property="Background" Value="{StaticResource Paper}" />
    </Style>

    <!-- Controls: 4 px corners; panels use 8. -->
    <Style Selector="Button, ToggleButton, TextBox, ComboBox, NumericUpDown">
      <Setter Property="CornerRadius" Value="4" />
    </Style>

    <!-- Secondary buttons: outlined, like LogicERP's Bootstrap buttons, not filled grey blocks. -->
    <Style Selector="Button:not(.primary):not(.quiet):not(.nav)">
      <Setter Property="Background" Value="{StaticResource Paper}" />
      <Setter Property="BorderBrush" Value="{StaticResource Rule}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{StaticResource Charcoal}" />
    </Style>
    <Style Selector="Button:not(.primary):not(.quiet):not(.nav):pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource Hover}" />
      <Setter Property="BorderBrush" Value="{StaticResource TealLight}" />
    </Style>

    <!-- Disabled buttons stay outlined and fade, instead of turning into grey blocks. -->
    <Style Selector="Button:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource Paper}" />
      <Setter Property="BorderBrush" Value="{StaticResource Rule}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="#A7B1B5" />
    </Style>



    <!-- File tabs above the log: small, quiet, teal underline on the open one. -->
    <Style Selector="TabControl#Tabs TabItem">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="Padding" Value="12,4" />
      <Setter Property="Foreground" Value="{StaticResource Slate}" />
    </Style>
    <Style Selector="TabControl#Tabs TabItem:selected">
      <Setter Property="Foreground" Value="{StaticResource Charcoal}" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="TabControl#Tabs TabItem:selected /template/ Border#PART_SelectedPipe">
      <Setter Property="Background" Value="{StaticResource Teal}" />
    </Style>

    <!-- Primary action: filled teal. -->
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{StaticResource Teal}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource TealDark}" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource TealDark}" />
    </Style>

    <!-- Quiet buttons: header icons, column headers, sidebar entries. -->
    <Style Selector="Button.quiet">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.quiet:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource Hover}" />
    </Style>

    <!-- Sidebar navigation entries. -->
    <Style Selector="Button.nav">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Height" Value="44" />
      <Setter Property="Padding" Value="16,0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.nav:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource Hover}" />
    </Style>
    <Style Selector="Button.nav.active /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource TealMist}" />
      <Setter Property="BorderBrush" Value="{StaticResource Teal}" />
      <Setter Property="BorderThickness" Value="3,0,0,0" />
    </Style>
    <Style Selector="Button.nav.active TextBlock">
      <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <!-- List selection: teal mist, not the default blue. -->
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource TealMist}" />
    </Style>
    <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource TealMist}" />
    </Style>
    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource Hover}" />
    </Style>
    <Style Selector="ListBoxItem">
      <Setter Property="Foreground" Value="{StaticResource Charcoal}" />
    </Style>

    <!-- Header "Following" toggle: a quiet pill that turns teal when on. -->
    <Style Selector="ToggleButton.pill">
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Padding" Value="14,4" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="ToggleButton.pill:checked /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource Teal}" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="ToggleButton.pill:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource TealDark}" />
      <Setter Property="Foreground" Value="White" />
    </Style>

    <Style Selector="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource Charcoal}" />
    </Style>
  </Application.Styles>
</Application>
